{
    "configurations": [
        {
            "name": "EFR32MG24-Matter",
            "includePath": [
                "${workspaceRoot}/**"
            ],
            // 3. 全局宏定义（让 IntelliSense 识别特定芯片平台和 Matter 配置）
            "compilerPath": "~/.silabs/slt/installs/conan/p/gcc-a442105b5c2637/p/bin/arm-none-eabi-gcc",
            "defines": [
                "CHIP_HAVE_CONFIG_H=1",
                "EFR32MG24B210F1536IM48=1", // 根据你具体的芯片型号修改
                "_SILICON_LABS_32B_SERIES_2=1",
                "SILABS_BOARD_DEFAULT=1",
                "SL_MATTER_RGB_LED_ENABLED=1",
                "ARM_MATH_CM4=1",
                "__GNUC__",
                "__mixed_endian_select__"
            ],
            // 4. 交叉编译器路径（关键：让 VS Code 自动解析 GCC 的系统头文件）
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ],
    "version": 4
}