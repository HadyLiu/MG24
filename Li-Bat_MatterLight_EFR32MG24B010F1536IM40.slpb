---
parameters: []
constants:
- name: "workspace_name"
  value: "Li-Bat_MatterLight_EFR32MG24B010F1536IM40"
- path: "MatterLightOverThread/MatterLightOverThread.slpb"
- path: "Matter-Bootloader/Matter-Bootloader.slpb"
steps:
- task: "convert"
  output: "artifact/{{workspace_name}}-full.s37"
  input:
  - "{{bootloader_binary}}"
  - "{{application_binary}}"
- task: "create_gbl"
  output: "artifact/{{workspace_name}}-app-only.gbl"
  app: "{{application_binary}}"
